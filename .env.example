# Postgres — on Vercel, add Neon from the Marketplace and it sets this for you
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Only these Google accounts can sign in
ALLOWED_EMAILS="innompeta@gmail.com,mibaureni@gmail.com"

# Adzuna API (https://developer.adzuna.com) — free key
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=""
